# JWT Configuration
# Copy this file to .env and update with your values
# Generate a strong secret key: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-here-minimum-256-bits
JWT_EXPIRATION_MINUTES=180

# Database Configuration
DB_URL=jdbc:h2:mem:eventdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_USERNAME=sa
DB_PASSWORD=

# Server Configuration
SERVER_PORT=8080
